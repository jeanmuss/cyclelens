{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run project-public-data && npm run generate-data-manifest && vite --host 127.0.0.1",
    "admin:macro-events": "node scripts/macro-events-admin-api.mjs --scope owner_private",
    "build": "npm run build:public-retired",
    "build:owner": "npm run project-owner-data && npm run generate-owner-data-manifest && vite build --mode owner",
    "build:admin": "npm run project-public-data && npm run generate-data-manifest && vite build --mode admin",
    "build:owner:functions": "wrangler pages functions build functions --outdir .wrangler/owner-functions",
    "build:admin:functions": "wrangler pages functions build functions --outdir .wrangler/admin-functions",
    "build:public-retired": "node scripts/build-public-retired.mjs",
    "build:pages": "npm run build:public-retired",
    "lint": "node scripts/lint-source.mjs",
    "test": "node --test",
    "check": "npm run lint && npm test && npm run verify-market-calendar && npm run build:public-retired",
    "preview": "npm run build:public-retired && vite preview --host 127.0.0.1 --outDir dist-public",
    "preview:owner": "vite preview --host 127.0.0.1 --outDir dist-owner",
    "preview:admin": "vite preview --host 127.0.0.1 --outDir dist-admin",
    "prepare-owner-data": "node scripts/prepare-owner-data.mjs",
    "refresh-cmc-provider-state": "node scripts/refresh-cmc-provider-state.mjs --scope owner_private",
    "update-data": "node scripts/update-market-data.mjs --scope owner_private",
    "update-crypto-liquidity": "node scripts/update-crypto-liquidity-data.mjs --scope owner_private",
    "apply-reviewed-treasuries": "node scripts/apply-reviewed-treasury-disclosures.mjs --scope owner_private",
    "update-market-session": "node scripts/update-market-session-data.mjs --scope owner_private",
    "update-market-session-calendar": "node scripts/update-market-session-data.mjs --calendar-only --scope owner_private",
    "update-chip-chain": "node scripts/update-chip-chain-data.mjs chip --scope owner_private",
    "update-robot-chain": "node scripts/update-chip-chain-data.mjs robot --scope owner_private",
    "update-equity-fast-data": "python scripts/update-equity-fast-data.py --scope owner_private",
    "update-equity-data": "python scripts/update-equity-data.py --scope owner_private",
    "sync-manual-macro-events": "node scripts/sync-manual-macro-events-from-supabase.mjs --scope owner_private",
    "update-macro-calendar": "python scripts/update-macro-calendar.py --scope owner_private",
    "update-chart-series": "node scripts/update-chart-series-data.mjs --scope owner_private",
    "persist-market-history": "node scripts/persist-market-metric-history.mjs --scope owner_private",
    "project-public-data": "node scripts/project-public-metrics.mjs --scope public",
    "project-owner-data": "node scripts/project-public-metrics.mjs --scope owner_private",
    "generate-data-manifest": "node scripts/generate-data-manifest.mjs",
    "generate-owner-data-manifest": "node scripts/generate-owner-data-manifest.mjs",
    "validate-owner-release-data": "node scripts/validate-owner-release-data.mjs",
    "verify-market-calendar": "node scripts/verify-market-session-calendar.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "wrangler": "4.112.0"
  }
}
